#!/usr/bin/env bash
#
# check-ipc — IPC parity gate: keybinds/buttons may only dispatch to handlers
# that actually exist. Adapted from ryoku-arch's shell-binds audit.
#
# Three sets are compared:
#   DECLARED — IpcHandler target/function pairs extracted live from any
#              shell .qml under bar/ and settings/ (handlers may live in
#              components/services; the code is the truth
#              for what exists)
#   USED     — `ipc -c <proc> call <target> <fn>` callers found in
#              tools/keybinds-default.json (P3.6: THE keybind single source —
#              omni-nix's keybindings.lua keeps only non-velocity binds now),
#              omni-nix configs, and across this repo
#   MANIFEST — tools/ipc-surface.txt, the reviewed contract (what each
#              handler is FOR: bound / internal / manual / unused)
#
# Hard failures:
#   - a USED pair with no DECLARED handler      (silent no-op keybind)
#   - a MANIFEST entry with no DECLARED handler (stale contract)
#   - a `bound` entry with no available keybind in keybinds-default.json
#   - a keybind pair NOT marked bound in the manifest (drift, other direction)
#   - an `internal` entry with no call site found in the repo
#   - bar/lib/keybinds-default.mjs (the cheat-sheet fallback) out of sync
#     with the single source
# Warnings (exit 0): `unused` handlers, MANIFEST entries missing from USED,
# a missing keybinds-default.json (fixtures/dev trees) — bound checks skip.
#
# Environment overrides (for testing): IPC_QS_DIR (this repo),
# IPC_OMNI_DIR (omni-nix checkout), IPC_SURFACE (manifest path),
# IPC_BINDS_JSON (keybinds single source).
set -euo pipefail

QS_DIR="${IPC_QS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
OMNI_DIR="${IPC_OMNI_DIR:-$HOME/.omni-nix}"
SURFACE="${IPC_SURFACE:-$QS_DIR/tools/ipc-surface.txt}"
KEYBINDS="$OMNI_DIR/configs/hypr/keybindings.lua"
BINDS_JSON="${IPC_BINDS_JSON:-$QS_DIR/tools/keybinds-default.json}"

status=0
fail() { echo "check-ipc: FAIL: $*" >&2; status=1; }
warn() { echo "check-ipc: warn: $*" >&2; }

# --- DECLARED: target.function from both shell.qml roots ----------------------
declared="$(
  awk '
    # brace-depth state machine (NOT indent matching — root-level handlers in
    # component files close functions at 4 spaces and broke the old ^    })
    # heuristic, silently dropping every function after the first).
    /IpcHandler \{/ && !inipc { inipc = 1; t = ""; depth = 0 }
    inipc {
      if (/^[[:space:]]*target[[:space:]]*:[[:space:]]*"/) {
        x = $0; sub(/.*target:/, "", x); gsub(/["[:space:]]/, "", x); t = x
      }
      if ($0 ~ /function [A-Za-z]/) {
        f = $0; sub(/.*function[[:space:]]+/, "", f); sub(/[([:space:]].*/, "", f)
        if (t != "" && f != "") print t "." f
      }
      n = gsub(/{/, "{"); m = gsub(/}/, "}")
      depth += n - m
      if (depth <= 0) inipc = 0
    }
  ' $(find "$QS_DIR/bar" "$QS_DIR/settings" -name "*.qml" 2>/dev/null) | sort -u
)"
[[ -n $declared ]] || { fail "no IpcHandler functions extracted — extraction broke"; exit 1; }

# --- USED: caller strings from keybinds + repo -------------------------------
used_raw="$(
  {
    grep -hEo 'ipc -c [a-zA-Z]+ (call )+[A-Za-z]+( [A-Za-z]+)?' "$KEYBINDS" 2>/dev/null || true
    grep -rhoE '(quickshell|qs)[ a-zA-Z]*-c [a-zA-Z]+ (call|ipc call) [A-Za-z]+ [A-Za-z]+' \
      "$QS_DIR" \
      --include='*.qml' --include='*.sh' 2>/dev/null |
      grep -v "$QS_DIR/\.claude" || true
    grep -hoE 'quickshell ipc -c [a-zA-Z]+ call [A-Za-z]+ [A-Za-z]+' \
      $(grep -rl 'quickshell ipc' "$OMNI_DIR/configs" 2>/dev/null) 2>/dev/null </dev/null || true
    # ^ </dev/null: when OMNI_DIR is missing the file list is empty and grep
    # would fall through to reading stdin — hanging the whole gate (flaky,
    # stdin-lottery; bit twice in one session)
    # argv-array form: Process.command / ctx.run(["qs","-c",PROC,"ipc","call",
    # TARGET,FN,...]) — one element per line, invisible to the string greps
    # above. Both element orders occur (ipc before/after -c). Conditional fn
    # names (`on ? "enable" : "disable"`) cannot match — keep such pairs manual.
    # (No apostrophes in comments inside $( ): bash 3.2 parses them as quotes.)
    grep -rhoE '"-c", *"[a-zA-Z]+", *"ipc", *"call", *"[A-Za-z]+", *"[A-Za-z]+"' \
      "$QS_DIR" --include='*.qml' 2>/dev/null | grep -v "$QS_DIR/\.claude" | sed 's/[",]//g' || true
    grep -rhoE '"ipc", *"-c", *"[a-zA-Z]+", *"call", *"[A-Za-z]+", *"[A-Za-z]+"' \
      "$QS_DIR" --include='*.qml' 2>/dev/null | grep -v "$QS_DIR/\.claude" | sed 's/[",]//g' || true
  } | awk '{
    # normalize: ... -c <proc> ... call <target> <fn>  ->  proc|target|fn
    for (i = 1; i <= NF; i++) if ($i == "-c") { proc = $(i+1) }
    for (i = 1; i <= NF; i++) if ($i == "call") { t = $(i+1); f = $(i+2) }
    if (proc != "" && t != "" && f != "") print proc "|" t "." f
  }' | sort -u
)"

# --- P3.6: the keybinds single source ------------------------------------------
# tools/keybinds-default.json is THE keybind table (D2/D3); the HM module
# renders velocity-binds.lua + the cheat-sheet json from it. Its AVAILABLE
# `ipc` actions are callers like any other: they must hit DECLARED handlers,
# the manifest must mark them bound, and bar/lib/keybinds-default.mjs (the
# overlay's embedded fallback) must match row-for-row. Parsed with node —
# jq is not in the flake-gates closure; node is.
json_ipc=""
if [[ -f $BINDS_JSON ]]; then
  json_ipc="$(node -e '
    const fs = require("fs");
    const doc = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    let bad = 0;
    for (const b of (doc.binds || [])) {
      if (b.available === false) continue;
      const toks = String(b.action).split(" ");
      if (toks[0] === "ipc" && toks.length >= 3) console.log(toks[1] + "." + toks[2]);
      else if (toks[0] !== "exec" || toks.length < 2) { console.error("bad action: " + b.action); bad = 1; }
    }
    process.exit(bad);
  ' "$BINDS_JSON" 2>/dev/null || true)"
  # a keybind to a nonexistent handler is the silent-no-op class itself
  while IFS= read -r pair; do
    [[ -n $pair ]] || continue
    grep -qxF "$pair" <<< "$declared" || fail "keybinds-default.json dispatches to undeclared handler '$pair'"
  done <<< "$json_ipc"
  used_raw="$(sort -u <<< "$used_raw"$'\n'"bar|$json_ipc")"
else
  warn "keybinds single source missing ($BINDS_JSON) — bound checks skipped (fixtures/dev trees only)"
fi

# --- checks -------------------------------------------------------------------
while IFS='|' read -r proc pair; do
  [[ -n $pair ]] || continue
  if ! grep -qxF "$pair" <<< "$declared"; then
    fail "caller '$proc' dispatches to undeclared handler '$pair'"
  fi
done <<< "$used_raw"

while read -r pair klass rest; do
  case $pair in ''|\#*) continue ;; esac
  if ! grep -qxF "$pair" <<< "$declared"; then
    fail "manifest lists '$pair' but no handler declares it"
    continue
  fi
  case $klass in
    bound)
      # The single source must carry this pair as an AVAILABLE ipc action.
      if [[ -f $BINDS_JSON ]]; then
        if ! grep -qxF "$pair" <<< "$json_ipc"; then
          fail "'$pair' is marked bound but no available keybind dispatches it in $BINDS_JSON"
        fi
      elif ! grep -q "call ${pair%%.*} ${pair#*.}" "$KEYBINDS" 2>/dev/null; then
        fail "'$pair' is marked bound but no keybind dispatches it in $KEYBINDS"
      fi ;;
    internal)
      # Call sites count in both spellings: the spawn-string form
      # (`call Target fn`) and the argv-array form
      # (`"call", "Target", "fn"` inside Process.command / ctx.run).
      t="${pair%%.*}"; f="${pair#*.}"
      hit="$( { grep -rl "call ${t} ${f}" "$QS_DIR" --include='*.qml' 2>/dev/null
                grep -rl "\"call\", *\"${t}\", *\"${f}\"" "$QS_DIR" --include='*.qml' 2>/dev/null; } | head -1 || true)"
      [[ -n $hit ]] || fail "'$pair' is marked internal but no repo call site was found" ;;
    manual) : ;;
    unused) warn "'$pair' is declared but unused — wire, delete, or reclassify" ;;
    *)      fail "'$pair' has unknown class '$klass' (bound|internal|manual|unused)" ;;
  esac
done < "$SURFACE"

# Orphan report: declared handlers absent from the manifest entirely.
while IFS= read -r d; do
  grep -q "^$d[[:space:]]" "$SURFACE" || warn "declared '$d' is not in $SURFACE (add it with a class)"
done <<< "$declared"

# Reverse drift: every available JSON keybind pair must be marked bound.
if [[ -n $json_ipc ]]; then
  while IFS= read -r pair; do
    [[ -n $pair ]] || continue
    grep -q "^$pair[[:space:]]" "$SURFACE" || fail "keybind '$pair' is not marked bound in $SURFACE"
  done <<< "$json_ipc"
fi

# The cheat-sheet's embedded fallback must never diverge from the source.
if [[ -f $BINDS_JSON && -f $QS_DIR/bar/lib/keybinds-default.mjs ]]; then
  if ! node -e '
    const fs = require("fs");
    const want = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).binds;
    import(process.argv[2]).then((m) => {
      const norm = (r) => JSON.stringify({ key: r.key, action: r.action, label: r.label,
                                           section: r.section, available: r.available, order: r.order });
      const a = want.map(norm).join("\n");
      const b = (m.KEYBINDS_DEFAULT || []).map(norm).join("\n");
      if (a !== b) { console.error("embedded copy diverged from the single source"); process.exit(1); }
    }).catch((e) => { console.error(e.message); process.exit(1); });
  ' "$BINDS_JSON" "$QS_DIR/bar/lib/keybinds-default.mjs"; then
    fail "bar/lib/keybinds-default.mjs is out of sync with $BINDS_JSON (regenerate the embedded copy)"
  fi
fi

# --- P1.6: one CLI call form in THIS repo -------------------------------------
# `qs -c <proc> ipc call …` is the recorded form (P0 Facts: both spellings
# work at runtime, but a single spelling keeps callers greppable and the
# scanners above honest). The omni-nix extraction still accepts `quickshell
# ipc` — a different tree. tools/ is exempt: its dev harness targets `-p`
# instances positionally, which the named-config form cannot express. Only
# call SHAPES match — prose that merely names the CLI (`quickshell ipc` CLI
# subcommand) is fine.
stray="$(grep -rnE 'quickshell ipc (-c |--config )[a-zA-Z]+ call|quickshell ipc call' \
    "$QS_DIR/bar" "$QS_DIR/settings" "$QS_DIR/plugins" "$QS_DIR/shared" "$QS_DIR/bin" \
    --include='*.qml' --include='*.mjs' --include='*.sh' 2>/dev/null || true)"
if [[ -n $stray ]]; then
  fail "non-canonical IPC call form (use: qs -c <proc> ipc call <target> <fn>):"
  echo "$stray" | sed 's/^/    /' >&2
fi

if (( status == 0 )); then
  echo "check-ipc: OK ($(wc -l <<< "$declared") declared, $(grep -c . <<< "$used_raw") used, manifest consistent)"
fi
exit "$status"
