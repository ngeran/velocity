#!/usr/bin/env node
// check-shared — the shared/ sync gate: every registered per-root copy must
// be byte-identical to its canonical file after skipping the copy's line-1
// GENERATED stamp (see shared/README.md). Drift means someone edited a root
// copy directly; fix is `tools/sync-shared`, never a hand-edit of the copy.
// A missing/wrong stamp is itself a failure (I3).
'use strict'
const fs = require('fs')
const path = require('path')
const crypto = require('crypto')

const root = path.resolve(__dirname, '..')

// The one registration table, shared with tools/sync-shared.
const TARGETS = require('./shared-targets.js')

const sha256 = (buf) => crypto.createHash('sha256').update(buf).digest('hex')
const stampFor = (src) => `// GENERATED from ${src} by tools/sync-shared — do not edit`

let failures = 0
for (const [src, dsts] of Object.entries(TARGETS)) {
  const srcPath = path.join(root, src)
  if (!fs.existsSync(srcPath)) {
    console.error(`check-shared: missing canonical file ${src}`)
    failures++
    continue
  }
  const canon = sha256(fs.readFileSync(srcPath))
  for (const dst of dsts) {
    const dstPath = path.join(root, dst)
    if (!fs.existsSync(dstPath)) {
      console.error(`check-shared: ${dst} missing — run tools/sync-shared`)
      failures++
      continue
    }
    const buf = fs.readFileSync(dstPath)
    const firstNl = buf.indexOf(10)
    const firstLine = (firstNl === -1 ? buf : buf.slice(0, firstNl)).toString('utf8')
    if (firstLine !== stampFor(src)) {
      console.error(`check-shared: ${dst} missing GENERATED stamp (line 1) — run tools/sync-shared`)
      failures++
      continue
    }
    if (sha256(buf.slice(firstNl + 1)) !== canon) {
      console.error(`check-shared: DRIFT ${dst} differs from ${src} — run tools/sync-shared`)
      failures++
    }
  }
}

if (failures) {
  console.error(`check-shared: FAIL (${failures})`)
  process.exit(1)
}
console.log('check-shared: OK')
