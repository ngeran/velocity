#!/usr/bin/env node
// check-engine — the plugin engine's architecture rules (plan D1/D3/D13).
//
//   D1   bar/engine/** imports nothing outside itself: QML may import only
//        Qt/Quickshell modules and its own lib/; .mjs only ./ siblings.
//        The host hands the engine everything through hostApi.
//   D13  bar/Ui (qs.Ui) never touches engine, service or config singletons:
//        plugins load qs.Ui through the qs module path, and a singleton
//        reached from there could be a SECOND instance (two registries
//        scanning, writing state, splitting the popup slot). Engine state
//        reaches Ui components only through ctx.
//   D3   plugins never import bar internals by path (file:// or ../bar) —
//        UI parts come from qs.Ui, state from ctx.
//
// Usage: tools/check-engine   (exit 1 on any violation)
const fs = require("fs"), path = require("path")
process.chdir(path.join(__dirname, ".."))

let bad = 0, files = 0
const fail = (f, line, msg) => { console.log(`check-engine: FAIL ${f}:${line} — ${msg}`); bad++ }

function walk(d, ext, out) {
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
        const p = path.join(d, e.name)
        if (e.isDirectory()) { if (e.name !== ".git") walk(p, ext, out) }
        else if (ext.some(x => e.name.endsWith(x))) out.push(p)
    }
    return out
}
const lines = f => fs.readFileSync(f, "utf8").split("\n")
const code = l => l.replace(/\/\/.*$/, "")

// D1 — engine is standalone
for (const f of walk("bar/engine", [".qml", ".mjs"], [])) {
    files++
    lines(f).forEach((l, i) => {
        const c = code(l)
        let m
        if (f.endsWith(".qml") && (m = /^\s*import\s+"([^"]+)"/.exec(c)) && !/^lib\//.test(m[1]))
            fail(f, i + 1, `D1: engine QML imports "${m[1]}" (only lib/ and Qt/Quickshell modules allowed)`)
        if (f.endsWith(".qml") && /^\s*import\s+qs\./.test(c))
            fail(f, i + 1, "D1: engine QML imports a qs.* module")
        if (f.endsWith(".mjs") && (m = /\bfrom\s+["']([^"']+)["']|\bimport\s*\(\s*["']([^"']+)["']/.exec(c))) {
            const spec = m[1] || m[2]
            if (!/^\.\/[^/]+$/.test(spec) && !/^node:/.test(spec))
                fail(f, i + 1, `D1: engine lib imports "${spec}" (only ./ siblings)`)
        }
        if (/\b(Config|Services|Components)\.[A-Z]\w*/.test(c))
            fail(f, i + 1, "D1: engine references a bar singleton namespace")
    })
}

// D13 — qs.Ui stays stateless. Reviewed exceptions: file → import → why.
const UI_ALLOW = {
    "bar/Ui/PluginPopup.qml": { "../components": "Popover card primitive; its Config use is read-only tokens (plan D13)" }
}
for (const f of walk("bar/Ui", [".qml"], [])) {
    files++
    lines(f).forEach((l, i) => {
        const c = code(l)
        let m
        if ((m = /^\s*import\s+"([^"]+)"/.exec(c)) && /(^|\/)(engine|services|config|components|styles)(\/|$)/.test(m[1])
            && !(UI_ALLOW[f] && UI_ALLOW[f][m[1]]))
            fail(f, i + 1, `D13: qs.Ui imports "${m[1]}"`)
        if (/\b(PluginRegistry|PopupCoordinator|Engine\.|Services\.)/.test(c))
            fail(f, i + 1, "D13: qs.Ui references engine/service state — go through ctx")
    })
}

// D3 — a plugin's path imports stay inside its own folder (bar parts come
// from qs.Ui, state from ctx)
for (const root of ["plugins", "bar/builtins"]) {
    for (const name of fs.readdirSync(root)) {
        const pdir = path.resolve(root, name)
        if (!fs.statSync(pdir).isDirectory()) continue
        for (const f of walk(path.join(root, name), [".qml"], [])) {
            files++
            lines(f).forEach((l, i) => {
                const m = /^\s*import\s+"([^"]+)"/.exec(code(l))
                if (!m) return
                const target = path.resolve(path.dirname(f), m[1])
                // built-ins are first-party: they may wrap bar/components
                const ok = !/^file:/.test(m[1]) && (target === pdir || target.indexOf(pdir + path.sep) === 0
                    || (root === "bar/builtins" && target === path.resolve("bar/components")))
                if (!ok) fail(f, i + 1, `D3: imports "${m[1]}" outside the plugin folder — use qs.Ui and ctx`)
            })
        }
    }
}

console.log(`check-engine: ${files} files`)
if (bad > 0) { console.log(`check-engine: FAIL (${bad})`); process.exit(1) }
console.log("check-engine: OK")
