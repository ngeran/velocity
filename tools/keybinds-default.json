{
  "meta": {
    "source": "D3 table (ledger) + the three pre-existing velocity binds preserved through the omni-nix move (SUPER+SHIFT+T, SUPER+SHIFT+B, SUPER+SHIFT+SPACE)",
    "consumed-by": [
      "nix/hm-module.nix — programs.velocity.keybinds default; renders ~/.config/hypr/velocity-binds.lua + ~/.config/velocity/keybinds.json",
      "tools/check-ipc — the bound pair set (available binds only)",
      "bar/lib/keybinds-default.mjs — embedded fallback for KeybindsOverlay (dev checkouts without the HM render)"
    ],
    "action-forms": {
      "exec <cmd>": "hyprland hl.dsp.exec_cmd(<cmd>)",
      "ipc <target> <fn> [arg…]": "hyprland hl.dsp.exec_cmd(qs -c bar ipc call <target> <fn> [arg…])"
    },
    "deferred-note": "available=false rows render in the cheat sheet (marked P7) but generate NO Hyprland bind — the handler ships with P7 (deck G6, charms G3, screenshot G2). SUPER+SHIFT+S/Print keep the omni-nix grim binds until then."
  },
  "binds": [
