#!/bin/sh
# =============================================================================
# velocity-lock — lock the session with the velocity lock (lock/ config root)
# =============================================================================
# Runs `quickshell -c lock`: a WlSessionLock (ext_session_lock_v1) with PAM
# auth against the "velocity-lock" service. The process stays until unlock;
# exiting after a successful unlock is how hypridle sees the session unlock.
#
#   velocity-lock            lock the session (real mode)
#   velocity-lock preview    render the lock in a plain overlay window —
#                            nothing is locked, PAM never starts
#
# SECURITY: without /etc/pam.d/velocity-lock the lock cannot authenticate and
# would wedge the session (recovery: TTY → `loginctl unlock-session`, or
# hyprlock takeover via misc.allow_session_lock_restore). Refuse instead.
# The PAM service comes from this flake's nixosModules.default
# (security.pam.services.velocity-lock) — imported by omni-nix
# hosts/desktop/default.nix; same trap as the hyprlock note there.
# =============================================================================

# PATH only — a hard-coded store/profile path rots on every rebuild (P1.8).
QS_BIN="$(command -v quickshell || true)"
if [ -z "$QS_BIN" ]; then
  echo "velocity-lock: quickshell not on PATH" >&2
  exit 1
fi

# The lock UI's FileViews shell out via `sh -c cat` (bar-config, theme,
# plugin state). hypridle's unit PATH is a closed set with NO sh — without
# this line every one of those reads failed and the lock silently ran on
# defaults (live evidence: hypridle journal, P3 lock test). The session PATH
# is the established fix shape on this host (cf. brightnessctl in
# hypridle.conf). PAM and Wayland are unaffected either way.
PATH="/run/current-system/sw/bin:$PATH"
export PATH

case "${1-}" in
  preview)
    exec env VELOCITY_LOCK_PREVIEW=1 "$QS_BIN" -c lock
    ;;
  ""|lock)
    # real mode — refuse to lock without the PAM service (see SECURITY above)
    if [ ! -f /etc/pam.d/velocity-lock ]; then
      echo "velocity-lock: /etc/pam.d/velocity-lock missing — omni-apply the PAM module first; refusing to lock" >&2
      exit 1
    fi
    # Re-entry guard (P3.4): hypridle can fire lock-session twice (idle
    # listener + before_sleep) while SUPER+L races them — ext_session_lock_v1
    # allows ONE holder, so a second process would sit waiting for a lock it
    # can never take. Already-locked = this request is satisfied; exit 0.
    if pgrep -f "$QS_BIN -c lock" >/dev/null 2>&1; then
      echo "velocity-lock: session already locked" >&2
      exit 0
    fi
    # P5.6 auto-pause: the panel is covered for the whole lock — freeze the
    # live wallpaper decode through the service (reason "lock"), lift it the
    # moment this process exits (unlock). No `exec`: the shell must survive
    # to run the resume. `|| true` — a down/absent bar must never block the
    # lock itself. The service keeps the reason transient and honors the
    # user's own HOLD, so this cannot un-pause something the user froze.
    "$QS_BIN" ipc -c bar call wallpaper-service pauseFor lock >/dev/null 2>&1 || true
    "$QS_BIN" -c lock
    "$QS_BIN" ipc -c bar call wallpaper-service resumeFor lock >/dev/null 2>&1 || true
    ;;
  *)
    echo "usage: velocity-lock [preview]" >&2
    exit 2
    ;;
esac
