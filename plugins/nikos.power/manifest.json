{
  "schemaVersion": 2,
  "api": 2,
  "id": "nikos.power",
  "name": "Power",
  "version": "1.0.0",
  "description": "Battery glyph + power popup: state, charge %, source, charge bar and a POWER MENU deep-link (suspend/reboot/shutdown). Native UPower — zero forks.",
  "author": "nikos",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "bar": {
    "defaultSection": "right"
  },
  "commands": [
    "qs"
  ],
  "ipc": [
    "toggle"
  ],
  "settings": {
    "lowThreshold": {
      "type": "number",
      "default": 20,
      "min": 5,
      "max": 50,
      "label": "Low battery % (error colour)"
    },
    "warnThreshold": {
      "type": "number",
      "default": 50,
      "min": 10,
      "max": 90,
      "label": "Warning battery % (warning colour)"
    }
  }
}
