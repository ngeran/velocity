{
  "schemaVersion": 2,
  "api": 2,
  "id": "nikos.clock",
  "name": "Clock",
  "version": "1.0.0",
  "description": "Centered clock + date. Click toggles the calendar popup. Occupies the CENTER slot.",
  "author": "nikos",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "bar": {
    "defaultSection": "center"
  },
  "commands": [],
  "ipc": [
    "toggle"
  ],
  "settings": {
    "zone": {
      "type": "enum",
      "default": "Local",
      "options": [
        "Local",
        "Europe/Athens",
        "Europe/London",
        "America/New_York",
        "America/Chicago",
        "America/Los_Angeles",
        "Asia/Tokyo",
        "UTC"
      ],
      "label": "Clock zone"
    }
  }
}
