{
  "schemaVersion": 2,
  "api": 2,
  "id": "nikos.clock",
  "name": "Clock",
  "version": "1.0.0",
  "description": "Centered clock + date. Click toggles the calendar popup with a weather today card (keyless Open-Meteo). Occupies the CENTER slot.",
  "author": "nikos",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "ServiceRoot.qml"
  },
  "bar": {
    "defaultSection": "center"
  },
  "commands": [
    "curl",
    "sh",
    "mkdir"
  ],
  "ipc": [
    "toggle",
    "open",
    "close",
    "refresh"
  ],
  "settings": {
    "zone": {
      "type": "enum",
      "default": "Local",
      "options": [
        "Local",
        "Europe/Athens",
        "Europe/London",
        "America/New_York",
        "America/Chicago",
        "America/Los_Angeles",
        "Asia/Tokyo",
        "UTC"
      ],
      "label": "Clock zone"
    },
    "showWeather": {
      "type": "bool",
      "default": true,
      "label": "Weather in the calendar panel"
    },
    "place": {
      "type": "string",
      "default": "",
      "label": "Place label (blank = auto-detected city)"
    },
    "lat": {
      "type": "number",
      "default": 0,
      "min": -90,
      "max": 90,
      "label": "Latitude (0 = auto via IP locate)"
    },
    "lon": {
      "type": "number",
      "default": 0,
      "min": -180,
      "max": 180,
      "label": "Longitude (0 = auto via IP locate)"
    }
  }
}
