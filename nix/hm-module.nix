# home-manager module: programs.velocity
#
#   imports = [ velocity.homeManagerModules.default ];
#   programs.velocity = {
#     enable = true;
#     checkout = "/home/me/src/velocity";        # linked to ~/.config/quickshell
#     plugins = [ (velocity.lib.mkPlugin pkgs { src = ./plugins/acme.weather; }) ];
#   };
#
# Since P3 the module ships the whole rice: tools (runtimeInputs), fonts,
# the clipboard-history unit, the packaged velocity-lock, the generated
# keybinds (velocity-binds.lua + keybinds.json) and the plugin seed. The bar
# unit (quickshell-bar) is generated here too — with the wayland-socket
# gate, so it starts correctly on hosts where the graphical session is not
# systemd-managed (graphical-session.target never activates there; see the
# unit comment). Host PAM for the lock lives in velocity.nixosModules.default.
#
# Plugins from `plugins` are read-only system plugins (VELOCITY_PLUGIN_PATH).
# Like every plugin they start disabled: `velocity-plugin enable <id>`.
self:
{ config, lib, pkgs, ... }:

let
  cfg = config.programs.velocity;
  cli = self.packages.${pkgs.stdenv.hostPlatform.system}.velocity-plugin;
  pluginTree = pkgs.symlinkJoin { name = "velocity-plugins"; paths = cfg.plugins; };
  pluginPath = "${pluginTree}/share/velocity/plugins";

  # ── Keybinds (D2/D3) ────────────────────────────────────────────────────────
  # The single source is the committed D3 table; the option defaults from it.
  # Rendered to BOTH ~/.config/hypr/velocity-binds.lua (Hyprland, required from
  # hyprland.lua after keybindings.lua) and ~/.config/velocity/keybinds.json
  # (the cheat sheet + check-ipc view of the same table).
  keybindsDefault = builtins.fromJSON (builtins.readFile ../tools/keybinds-default.json);

  defaultKeybinds = builtins.listToAttrs (map (b: {
    name = b.key;
    value = {
      action = b.action;
      label = b.label;
      section = b.section or "VELOCITY";
      available = b.available or true;
      order = b.order or 999;
    };
  }) keybindsDefault.binds);

  # Option attrset → ordered row list (mapAttrsToList yields alphabetical keys;
  # `order` restores the D3 table order).
  keybindsList = builtins.sort
    (a: b: (a.order or 999) < (b.order or 999))
    (lib.mapAttrsToList (key: v: { inherit key; } // v) cfg.keybinds);

  # "SUPER+SHIFT+SPACE" → `modShift .. " + SPACE"`; "PRINT" → `"PRINT"`.
  bindKeyExpr = key:
    let
      parts = map lib.trim (lib.splitString "+" key);
      hasSuper = lib.elem "SUPER" parts;
      hasShift = lib.elem "SHIFT" parts;
      keySeq = builtins.filter (p: p != "SUPER" && p != "SHIFT") parts;
      keyLit = lib.concatStringsSep " + " keySeq;
      modVar = if hasShift then "modShift" else "mod";
    in
      if hasSuper then "${modVar} .. \" + ${keyLit}\""
      else "\"${keyLit}\"";

  # "ipc launcher toggle" → `qs -c bar ipc call launcher toggle`;
  # "exec velocity-lock" → `velocity-lock`.
  bindCmd = action:
    let
      toks = lib.splitString " " action;
      kind = builtins.head toks;
      rest = builtins.tail toks;
    in
      if kind == "exec" then lib.concatStringsSep " " rest
      else if kind == "ipc" then "qs -c bar ipc call " + lib.concatStringsSep " " rest
      else throw "velocity keybind: action must be 'exec <cmd>' or 'ipc <target> <fn> [args]' — got '${action}'";

  velocityBindsLua = ''
    -- GENERATED by programs.velocity (nix/hm-module.nix) — DO NOT EDIT BY HAND.
    -- Source: tools/keybinds-default.json (D3 table) or programs.velocity.keybinds.
    -- Required from hyprland.lua AFTER keybindings.lua (flat name, same dir).
    -- available=false rows (P7 features) deliberately get NO bind — a bind
    -- without its handler is the silent-no-op class check-ipc exists to kill.
    local mod = MAIN_MOD
    local modShift = mod .. " + SHIFT"
  '' + lib.concatStringsSep "\n" (map (b:
    "hl.bind(${bindKeyExpr b.key}, hl.dsp.exec_cmd(\"${bindCmd b.action}\"))"
  ) (builtins.filter (b: (b.available or true)) keybindsList)) + "\n";

  # ── Fonts (P3.2) ─────────────────────────────────────────────────────────────
  # Doto — variable dot-matrix clock face (nikos.clock `clockFace = "dot"` on
  # large clocks + the lock screen). Ported from omni-nix modules/fonts.nix,
  # which owned it only because velocity didn't yet. OFL license shipped
  # alongside per its terms.
  doto = pkgs.runCommand "doto-font" { } ''
    mkdir -p $out/share/fonts/truetype $out/share/licenses/doto
    cp ${pkgs.fetchurl {
      name = "Doto-var.ttf";
      url = "https://github.com/google/fonts/raw/main/ofl/doto/Doto%5BROND%2Cwght%5D.ttf";
      hash = "sha256-b0/n03hTuR3zaY2qhM3i2+HJaV2IyYbmUQE0kQM31CY=";
    }} "$out/share/fonts/truetype/Doto[ROND,wght].ttf"
    cp ${pkgs.fetchurl {
      name = "Doto-OFL.txt";
      url = "https://github.com/google/fonts/raw/main/ofl/doto/OFL.txt";
      hash = "sha256-Jqe1i9umzainjKbos3kdgBO4q8bV5lGfhBk4k67gICA=";
    }} $out/share/licenses/doto/OFL.txt
  '';

  # Space Grotesk — variable UI font (velocity glyph-identity direction).
  space-grotesk = pkgs.runCommand "space-grotesk-font" { } ''
    mkdir -p $out/share/fonts/truetype $out/share/licenses/space-grotesk
    cp ${pkgs.fetchurl {
      name = "SpaceGrotesk-var.ttf";
      url = "https://github.com/google/fonts/raw/main/ofl/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf";
      hash = "sha256-rK1t4fyTQ29cDx9BN3Ue8E8a6jBj5wNlNZcP/PvXn3I=";
    }} "$out/share/fonts/truetype/SpaceGrotesk[wght].ttf"
    cp ${pkgs.fetchurl {
      name = "SpaceGrotesk-OFL.txt";
      url = "https://github.com/google/fonts/raw/main/ofl/spacegrotesk/OFL.txt";
      hash = "sha256-VkzlZcNxxeW78oYAZWWnyapVqfVufKWNVuBdZJ3WGnI=";
    }} $out/share/licenses/space-grotesk/OFL.txt
  '';

  # Space Mono — mono UI font (velocity glyph-identity direction). The four
  # weights are map-generated; the parens around the script matter: `+` binds
  # tighter than the trailing runCommand argument, and without them the whole
  # expression degrades to the derivation's outPath concatenated with the
  # script text — a string where home.packages demands a package.
  space-mono = pkgs.runCommand "space-mono-font" { } (''
    mkdir -p $out/share/fonts/truetype $out/share/licenses/space-mono
  '' + lib.concatStringsSep "\n" (map
    (weight: ''
      cp ${pkgs.fetchurl {
        name = "SpaceMono-${weight}.ttf";
        url = "https://github.com/google/fonts/raw/main/ofl/spacemono/SpaceMono-${weight}.ttf";
        hash = {
          "Regular"    = "sha256-lYN+GCuu6tqDNo93SNsoNX8KG3XGuE/3Blte35M8jhg=";
          "Bold"       = "sha256-QF5z1Br7flkG784gajJq9clW844lXzVCHCYOhh5ZnFk=";
          "Italic"     = "sha256-7KJkyGkKkf6DfRmmut8tiJYWEMTIqvyxllJhkqnyWMU=";
          "BoldItalic" = "sha256-zcyV7d7jEoealyhJTllfWRyxWfPydtebxYZz3sflcTg=";
        }.${weight};
      }} "$out/share/fonts/truetype/SpaceMono-${weight}.ttf"
    '')
    [ "Regular" "Bold" "Italic" "BoldItalic" ]
  ) + ''
    cp ${pkgs.fetchurl {
      name = "SpaceMono-OFL.txt";
      url = "https://github.com/google/fonts/raw/main/ofl/spacemono/OFL.txt";
      hash = "sha256-jk7kKyVT4eAVBOYcsNRtFIzYyeXqyqNiKn3y1PKVW58=";
    }} $out/share/licenses/space-mono/OFL.txt
  '');

  fontsList = [
    doto
    space-grotesk
    space-mono
    # nerd-fonts.jetbrains-mono covers both the UI font and
    # BarConfig.fontNerd ("JetBrainsMono Nerd Font"); symbols-only ships the
    # standalone Symbols Nerd Font family for plugins that ask for it.
    pkgs.nerd-fonts.symbols-only
    pkgs.nerd-fonts.jetbrains-mono
  ];

  # ── The wayland gate ─────────────────────────────────────────────────────────
  # Ported from omni-nix home/quickshell.nix (qs-wait-wayland): on this host
  # Hyprland runs outside systemd, graphical-session.target NEVER activates,
  # and the WAYLAND_DISPLAY var reaches the user manager only after
  # environment.lua imports it. Binding units to graphical-session.target
  # meant they never started; starting them at default.target meant Qt fell
  # back to xcb and crash-looped (18 core dumps across boots). The gate makes
  # default.target safe on every host: no matter when the unit activates, the
  # exec only happens once the session-declared socket exists.
  waylandGate = pkgs.writeShellApplication {
    name = "velocity-wait-wayland";
    runtimeInputs = [ pkgs.coreutils ];   # seq, sleep, id
    text = ''
      rt="''${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
      # Gate on the session-declared $WAYLAND_DISPLAY — NEVER hardcode the
      # socket name (compositors create wayland-0 OR wayland-1 et al).
      # `_` (not `i`): writeShellApplication runs shellcheck, which only
      # exempts `_` from its unused-variable check (SC2034).
      for _ in $(seq 1 120); do
        # ''${VAR:-}: nounset-safe — writeShellApplication runs set -u, and a
        # bare $WAYLAND_DISPLAY aborts with "unbound variable" when the unit
        # starts at default.target before environment.lua's env import
        # (2026-10-31: bar + cliphist each logged a failed start every boot;
        # the bar only came up 2s later via the client-request restart).
        [ -n "''${WAYLAND_DISPLAY:-}" ] && [ -S "$rt/''${WAYLAND_DISPLAY:-}" ] && exit 0
        sleep 0.5
      done
      echo "velocity-wait-wayland: timed out (WAYLAND_DISPLAY=''${WAYLAND_DISPLAY:-unset}, no socket in $rt)" >&2
      exit 1
    '';
  };

  # ── Plugin seed (P3.10) ──────────────────────────────────────────────────────
  # Seeds plugins-state.json ONLY when the file doesn't exist — the live file
  # is the bar's own state (enabled toggles + layout edits) and must never be
  # stomped by a rebuild. Runs as the bar unit's ExecStartPre.
  seedPlugins = pkgs.writeShellApplication {
    name = "velocity-seed-plugins";
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      state="''${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/plugins-state.json"
      if [ ! -f "$state" ]; then
        mkdir -p "$(dirname "$state")"
        cat > "$state" <<EOF
      {
        "schemaVersion": 2,
        "enabled": ${builtins.toJSON (builtins.listToAttrs (map (id: { name = id; value = true; }) cfg.enabledPlugins))},
        "layout": { "left": [], "center": [], "right": [] }
      }
      EOF
        echo "velocity-seed-plugins: seeded $state"
      fi
    '';
  };

  # ── Unit template ────────────────────────────────────────────────────────────
  # The bar forks hyprctl/journalctl/bluetoothctl etc from the system profile;
  # runtimeInputs adds what velocity itself needs on top.
  # /run/wrappers/bin carries the setuid wrappers (mount, fusermount3, …).
  servicePath = lib.concatStringsSep ":" [
    (lib.makeBinPath cfg.runtimeInputs)
    "/etc/profiles/per-user/%u/bin"
    "/run/wrappers/bin"
    "/run/current-system/sw/bin"
  ];

  mkVelocityUnit = name: preStarts: exec: extraEnv: {
    Unit = {
      Description = "Velocity ${name}";
      # Stop-propagation ONLY — never bind startup to this target: hosts
      # without a systemd-managed graphical session (this one) never activate
      # it and the unit would never start. Startup = default.target + gate.
      PartOf = [ "graphical-session.target" ];
      # P8.6 crash safety: a crash-loop must stop hammering the session —
      # 5 starts inside a minute (RestartSec=3 makes that ~15s of loop) and
      # the unit stays down for triage. BarWatch shows the offline banner;
      # `systemctl --user reset-failed quickshell-bar` re-arms after a fix.
      StartLimitIntervalSec = 60;
      StartLimitBurst = 5;
    };
    Service = {
      ExecStartPre = preStarts;
      ExecStart = exec;
      Restart = "on-failure";
      RestartSec = 3;
      Environment = [
        "PATH=${servicePath}"
        "VELOCITY_PLUGIN_PATH=${pluginPath}"
      ] ++ extraEnv;
    };
    Install.WantedBy = [ "default.target" ];
  };

  # P8.A: the bar's qmldir trees are named modules (bar.config / bar.engine /
  # bar.services) so one specifier = one singleton instance regardless of the
  # importer's depth (the import-split law: two specifiers for one directory
  # = two singleton instances). Named resolution needs the config root on the
  # engine's import path.
  barUnit = mkVelocityUnit "bar (Quickshell)"
    ([ "${waylandGate}/bin/velocity-wait-wayland" ]
      ++ lib.optionals (cfg.enabledPlugins != [ ])
        [ "${seedPlugins}/bin/velocity-seed-plugins" ])
    "${cfg.quickshellPackage}/bin/quickshell -c bar"
    [ "QML2_IMPORT_PATH=%h/.config/quickshell" ];

  cliphistUnit = mkVelocityUnit "clipboard history (cliphist)"
    [ "${waylandGate}/bin/velocity-wait-wayland" ]
    "${lib.getExe' pkgs.wl-clipboard "wl-paste"} --watch ${lib.getExe' pkgs.cliphist "cliphist"} store"
    [ ];

  # ── velocity-lock (P3.4) ─────────────────────────────────────────────────────
  # The repo script is the ONE implementation (P1.8: resolves quickshell via
  # command -v); packaging it puts the STORE quickshell on PATH so the check
  # resolves deterministically. procps (pgrep) backs the script's re-entry
  # guard — hypridle's unit PATH is a closed set, so the wrapper must carry
  # every command the script calls. The PAM service comes from
  # velocity.nixosModules.default (omni-nix imports it for the desktop host).
  velocityLock = pkgs.writeShellApplication {
    name = "velocity-lock";
    runtimeInputs = [ cfg.quickshellPackage pkgs.procps ];
    text = builtins.readFile ../bin/velocity-lock;
  };

  # ── velocity-lock-watchdog (P6.5 fail-safe) ──────────────────────────────────
  # Repairs a wedged lock instead of leaving the user to reboot: heartbeat
  # staleness (hung loop), locked=false zombie (hung quit), and the DPMS
  # surfaceless race — see the script header for the decision table. Timer
  # every 20 s; exits 0 instantly whenever no real lock is held. jq/procps/
  # systemd come from runtimeInputs (writeShellApplication PATH); velocity-lock
  # itself resolves through the unit PATH (servicePath carries the per-user
  # profile) with the script's own profile fallback as belt-and-braces.
  lockWatchdog = pkgs.writeShellApplication {
    name = "velocity-lock-watchdog";
    runtimeInputs = [ pkgs.coreutils pkgs.procps pkgs.jq pkgs.systemd ];
    text = builtins.readFile ../tools/velocity-lock-watchdog;
  };

  lockWatchdogUnit = {
    Unit.Description = "Velocity lock watchdog (repair a wedged velocity-lock)";
    Service = {
      Type = "oneshot";
      ExecStart = "${lockWatchdog}/bin/velocity-lock-watchdog";
      Environment = [ "PATH=${servicePath}" ];
    };
  };

  lockWatchdogTimer = {
    Unit.Description = "Periodic velocity-lock wedge repair";
    Timer = {
      OnBootSec = "90s";
      OnUnitActiveSec = "20s";
      AccuracySec = "5s";
    };
    Install.WantedBy = [ "timers.target" ];
  };

in
{
  options.programs.velocity = {
    enable = lib.mkEnableOption "the velocity Quickshell bar";

    checkout = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "/home/me/src/velocity";
      description = ''
        Absolute path of the velocity checkout. Linked out of store (so it
        stays writable) to ~/.config/quickshell. null = manage the link
        yourself (tools/deploy-link).
      '';
    };

    plugins = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = [ ];
      description = "Plugin packages built with velocity.lib.mkPlugin.";
    };

    quickshellPackage = lib.mkOption {
      type = lib.types.package;
      default = pkgs.quickshell;
      defaultText = lib.literalExpression "pkgs.quickshell";
      description = "Quickshell build that runs the bar (with the hosted dashboard).";
    };

    runtimeInputs = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      # Tools velocity's services shell out to directly — they must not depend
      # on happening to be installed system-wide:
      #   curl (weather) · util-linux (lsblk, storage) · procps (pkill) ·
      #   bash (thumbnail worker) · awww/ffmpeg (wallpaper backends, poster
      #   frames) · matugen (wallpaper → palette) · mpvpaper (engine backend)
      #   · hyprctl comes from the system (the compositor) — not owned here
      #   · dbus-send (notification bus probe) · cliphist + wl-clipboard
      #   (velocity.clipboard) · wf-recorder + slurp + grim + swappy (record/
      #   screenshot features) · qalc (charms calculator) · wtype (qa keys)
      #   · bluetoothctl (pair/trust/connect action queue; power/disconnect
      #   are native writes) · brightnessctl/ddcutil (brightness) ·
      #   powerprofilesctl (power profile tile). wpctl is NOT here: audio is
      #   the native Pipewire client (P2); nothing calls wpctl.
      default = with pkgs; [
        netcat networkmanager upower qrencode nodejs git coreutils findutils
        gnused gnugrep curl util-linux procps bash awww ffmpeg matugen mpvpaper
        dbus cliphist wl-clipboard wf-recorder slurp grim libqalculate wtype
        swappy bluez brightnessctl ddcutil power-profiles-daemon
      ];
      defaultText = lib.literalExpression ''
        with pkgs; [
          netcat networkmanager upower qrencode nodejs git coreutils findutils
          gnused gnugrep curl util-linux procps bash awww ffmpeg matugen mpvpaper
          dbus cliphist wl-clipboard wf-recorder slurp grim libqalculate wtype
          swappy bluez brightnessctl ddcutil power-profiles-daemon
        ]
      '';
      description = "Tools on the bar service's PATH (ahead of the user and system profiles). Also installed into the user profile so the session PATH gets them too (tools/check-tools reads the session).";
    };

    fonts.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Install the velocity fonts (Doto dot-matrix clock face, Space Grotesk,
        Space Mono, Nerd symbols + JetBrains Mono Nerd) and enable the user
        fontconfig. One owner: hosts that package Doto themselves should turn
        this off.
      '';
    };

    lock.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Install the packaged velocity-lock (WlSessionLock + PAM). The PAM
        service itself comes from velocity.nixosModules.default on hosts that
        import it — without it velocity-lock refuses to lock (it would wedge
        the session).
      '';
    };

    keybinds = lib.mkOption {
      type = lib.types.attrsOf (lib.types.submodule {
        options = {
          action = lib.mkOption {
            type = lib.types.str;
            description = ''
              "exec <cmd>" (run a command — e.g. the lock) or
              "ipc <target> <fn> [args…]" (qs -c bar ipc call …).
            '';
          };
          label = lib.mkOption {
            type = lib.types.str;
            description = "Cheat-sheet row for this key.";
          };
          section = lib.mkOption {
            type = lib.types.str;
            default = "VELOCITY";
            description = "Cheat-sheet section title.";
          };
          available = lib.mkOption {
            type = lib.types.bool;
            default = true;
            description = ''
              false = the row renders in the cheat sheet but generates NO
              Hyprland bind (the handler ships in a later phase).
            '';
          };
          order = lib.mkOption {
            type = lib.types.int;
            default = 999;
            description = "Cheat-sheet sort order.";
          };
        };
      });
      default = defaultKeybinds;
      defaultText = lib.literalExpression "the D3 table (tools/keybinds-default.json)";
      description = ''
        The velocity keybind table (D2/D3 single source). Rendered to
        ~/.config/hypr/velocity-binds.lua (required from hyprland.lua — the
        ONE require line omni-nix adds) and ~/.config/velocity/keybinds.json
        (cheat sheet + tools/check-ipc).
      '';
    };

    enabledPlugins = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "nikos.clock" "nikos.power" "nikos.keyboard" ];
      defaultText = lib.literalExpression ''
        [ "nikos.clock" "nikos.power" "nikos.keyboard" ]  # D10
      '';
      description = ''
        Third-party plugins enabled on FIRST boot: seeds plugins-state.json
        only when the file doesn't exist — the live file is the bar's state
        and is never stomped by a rebuild.
      '';
    };

    systemd.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Generate the systemd user units (quickshell-bar + velocity-cliphist;
        the dashboard is hosted in the bar process since P2.1). Units carry a
        wayland-socket gate, so they are safe to bind to default.target on
        hosts whose graphical session is not systemd-managed.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ cli ]
      ++ cfg.runtimeInputs
      ++ lib.optionals cfg.fonts.enable fontsList
      ++ lib.optionals cfg.lock.enable [ velocityLock ];

    home.sessionVariables.VELOCITY_PLUGIN_PATH = pluginPath;

    fonts.fontconfig.enable = lib.mkIf cfg.fonts.enable true;

    home.file.".config/quickshell" = lib.mkIf (cfg.checkout != null) {
      source = config.lib.file.mkOutOfStoreSymlink cfg.checkout;
    };

    # ── Keybind renders (D2/D3) ────────────────────────────────────────────
    # hypr/velocity-binds.lua: another per-file link inside the WRITABLE
    # ~/.config/hypr dir (omni-nix dotfiles.nix pattern — the dir itself is
    # never a store symlink). hyprland.lua gains one require("velocity-binds").
    xdg.configFile."hypr/velocity-binds.lua".text = velocityBindsLua;
    # The cheat sheet / check-ipc view of the same table.
    xdg.configFile."velocity/keybinds.json".text = builtins.toJSON {
      meta = {
        generated-by = "programs.velocity (nix/hm-module.nix)";
        source = "tools/keybinds-default.json";
      };
      binds = keybindsList;
    };

    systemd.user.services = lib.mkMerge [
      (lib.mkIf cfg.systemd.enable {
        quickshell-bar = barUnit;
        velocity-cliphist = cliphistUnit;
      })
      (lib.mkIf (cfg.systemd.enable && cfg.lock.enable) {
        velocity-lock-watchdog = lockWatchdogUnit;
      })
    ];

    systemd.user.timers = lib.mkIf (cfg.systemd.enable && cfg.lock.enable) {
      velocity-lock-watchdog = lockWatchdogTimer;
    };
  };
}
