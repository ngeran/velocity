# Velocity settings dashboard — systemd user unit.
# See quickshell-bar.service for install + rationale. Long-lived: the settings
# process hosts the dashboard, its IPC targets, and the theme-write stack.

[Unit]
Description=Velocity settings dashboard (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# env: works wherever quickshell is on the user manager's PATH (Arch:
# /usr/bin; NixOS: prefer the home-manager module in flake.nix, which writes
# these units with store paths and a full PATH).
ExecStart=/usr/bin/env quickshell -c settings
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
